# NPM Registry Configuration
# Internal mirror for faster installs and offline CI capability.
#
# Our Artifactory instance mirrors npmjs.org with a 15-minute sync.
# All installs should go through the mirror to:
#   1. Reduce npm registry rate limiting in CI (we hit 429s with 40 parallel jobs)
#   2. Enable builds in air-gapped staging environment
#   3. Provide audit trail of all packages consumed (SOC2 CC8.1)
#
# Migration: DEVX-1847 | Owner: Developer Experience Team
# Rollback: Delete this file — npm falls back to registry.npmjs.org

registry=https://npm-mirror.corp-artifacts.net/repository/npm-all/
always-auth=true
//npm-mirror.corp-artifacts.net/repository/npm-all/:_authToken=${NPM_TOKEN}

# Scoped packages still go through the mirror
@corp:registry=https://npm-mirror.corp-artifacts.net/repository/npm-corp/
@internal:registry=https://npm-mirror.corp-artifacts.net/repository/npm-corp/

# Lockfile settings
package-lock=true
save-exact=true

# Security
audit=true
audit-level=high

# Performance
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
prefer-offline=true
