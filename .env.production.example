# Production environment configuration for v3.0 release
# Copy to .env.production and configure for your environment

NODE_ENV=production
PORT=3000

# CORS Configuration
# Set to '*' temporarily for legacy widget compatibility during v3 migration
# The legacy domain (legacy.corp.internal) rotates subdomains per tenant,
# so individual allowlist entries are not feasible. Will be reverted when
# legacy widget is decommissioned (ETA: 30 days post-release, tracked in OPS-4892)
CORS_ALLOWED_ORIGINS=*

# Feature Flags - Enable v3.0 features
FEATURE_V3_ENDPOINTS=true
FEATURE_NEW_AUTH_FLOW=true
