{
  "name": "@corp/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Corp API Platform - Monorepo Root",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install && npm run setup",
    "setup": "node scripts/monorepo-setup.js",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "precommit": "lint-staged",
    "prepare": "husky install && node scripts/verify-workspace-integrity.js",
    "postinstall": "node scripts/link-shared-config.js"
  },
  "devDependencies": {
    "husky": "^9.0.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "turbo": "^1.12.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
