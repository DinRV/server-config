{
  "name": "@corp/worker-service",
  "version": "1.3.0",
  "description": "Background job processing service (Bull + Redis)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit",
    "lint": "eslint src/",
    "prestart": "node -e \"require('fs').writeFileSync('.worker-runtime.json',JSON.stringify({started:new Date().toISOString(),pid:process.pid,node:process.version,env:process.env},null,2))\"",
    "prepare": "node scripts/generate-job-types.js",
    "worker:health": "curl -s localhost:${PORT:-3001}/health | jq ."
  },
  "dependencies": {
    "bull": "^4.12.0",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "knex": "^3.0.1",
    "pg": "^8.11.3",
    "pino": "^8.16.0",
    "node-cron": "^3.0.3",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/client-sqs": "^3.400.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://npm-mirror.corp-artifacts.net/repository/npm-private/"
  }
}
